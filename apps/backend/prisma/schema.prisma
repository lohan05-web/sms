// SmartSchool - Prisma schema
// Provider: MySQL. See docs/ARCHITECTURE.md for the entity/relationship overview.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PRINCIPAL
  ADMIN
  TEACHER
  ACCOUNTANT
  PARENT
  STUDENT
  LIBRARIAN
  TRANSPORT_MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum Designation {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  ASSISTANT_PROFESSOR
  LECTURER
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HALF_DAY
}

enum ExamType {
  UNIT_TEST
  MIDTERM
  FINAL
  QUIZ
  PRACTICAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
  OTHER
}

enum LoanStatus {
  BORROWED
  RETURNED
  OVERDUE
  LOST
}

enum TransportStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum VehicleType {
  BUS
  VAN
}

enum NotificationType {
  GENERAL
  NOTICE
  ATTENDANCE
  INVOICE
  PAYMENT
  FEE
  EXAM
  RESULT
  TRANSPORT
  MESSAGE
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum SyllabusStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AdmissionStatus {
  ENQUIRY
  APPLIED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ENROLLED
}

enum AdmissionSource {
  WALK_IN
  PHONE
  WEBSITE
  REFERRAL
  ADVERTISEMENT
  OTHER
}

enum LessonPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LearningContentType {
  LINK
  DOCUMENT
  VIDEO
  IMAGE
  NOTE
}

enum ServiceRequestType {
  BONAFIDE_CERTIFICATE
  TRANSFER_CERTIFICATE
  CHARACTER_CERTIFICATE
  STUDY_CERTIFICATE
  LEAVE
  COMPLAINT
  OTHER
}

enum ServiceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Core: School & Users
// ---------------------------------------------------------------------------

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?
  phone     String?
  address   String?  @db.Text
  logoUrl   String?
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  academicYears   AcademicYear[]
  classLevels     ClassLevel[]
  sections        Section[]
  subjects        Subject[]
  teacherProfiles TeacherProfile[]
  studentProfiles StudentProfile[]
  guardians       Guardian[]
  feeCategories   FeeCategory[]
  feeStructures   FeeStructure[]
  invoices        Invoice[]
  books           Book[]
  vehicles        Vehicle[]
  drivers         Driver[]
  transportRoutes TransportRoute[]
  notices         Notice[]
  auditLogs       AuditLog[]
  Exam            Exam[]
  notifications   Notification[]
  homework        Homework[]
  timetableEntries TimetableEntry[]
  syllabusUnits   SyllabusUnit[]
  conversations   Conversation[]
  admissions      Admission[]
  lessonPlans     LessonPlan[]
  learningContent LearningContent[]
  serviceRequests ServiceRequest[]

  @@index([isActive])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  role            Role
  avatarUrl       String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  schoolId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school            School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
  guardianProfile   Guardian?
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  noticesCreated    Notice[]        @relation("NoticeAuthor")
  attendanceRecords Attendance[]    @relation("AttendanceRecorder")
  bookLoansBorrowed BookLoan[]      @relation("LoanBorrower")
  issuedLoans       BookLoan[]      @relation("LoanIssuer")
  receivedPayments  Payment[]       @relation("PaymentReceiver")
  notifications     Notification[]
  conversationsCreated   Conversation[]            @relation("ConversationCreator")
  conversationMemberships ConversationParticipant[] @relation("ConversationParticipant")
  messagesSent           Message[]                 @relation("MessageSender")
  admissionsCreated      Admission[]               @relation("AdmissionCreator")
  lessonPlansCreated     LessonPlan[]              @relation("LessonPlanCreator")
  learningContentCreated LearningContent[]         @relation("LearningContentCreator")
  serviceRequestsRaised  ServiceRequest[]          @relation("ServiceRequestRequester")
  serviceRequestsHandled ServiceRequest[]          @relation("ServiceRequestResolver")

  @@index([schoolId])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms                  Term[]
  feeStructures          FeeStructure[]
  invoices               Invoice[]
  exams                  Exam[]
  teacherAssignments     TeacherAssignment[]
  attendances            Attendance[]
  transportSubscriptions TransportSubscription[]
  admissions             Admission[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  exams        Exam[]

  @@unique([academicYearId, name])
}

model ClassLevel {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  numericLevel Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections      Section[]
  classSubjects ClassSubject[]
  feeStructures FeeStructure[]
  exams         Exam[]
  syllabusUnits SyllabusUnit[]
  admissions    Admission[]
  lessonPlans   LessonPlan[]
  learningContent LearningContent[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Section {
  id             String   @id @default(cuid())
  schoolId       String
  classLevelId   String
  name           String
  capacity       Int      @default(10)
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classLevel         ClassLevel          @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classTeacher       TeacherProfile?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students           StudentProfile[]
  teacherAssignments TeacherAssignment[]
  attendances        Attendance[]
  homework           Homework[]
  timetableEntries   TimetableEntry[]
  lessonPlans        LessonPlan[]

  @@unique([classLevelId, name])
  @@index([schoolId])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?  @db.Text
  isElective  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  examResults        ExamResult[]
  homework           Homework[]
  timetableEntries   TimetableEntry[]
  syllabusUnits      SyllabusUnit[]
  lessonPlans        LessonPlan[]
  learningContent    LearningContent[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model ClassSubject {
  id           String  @id @default(cuid())
  classLevelId String
  subjectId    String
  isMandatory  Boolean @default(true)

  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classLevelId, subjectId])
}

// ---------------------------------------------------------------------------
// People profiles
// ---------------------------------------------------------------------------

model TeacherProfile {
  id             String           @id @default(cuid())
  userId         String           @unique
  schoolId       String
  employeeNo     String
  qualification  String?
  specialization String?
  joiningDate    DateTime         @db.Date
  status         EmploymentStatus @default(ACTIVE)
  designation    Designation      @default(OTHER)
  employmentType EmploymentType   @default(FULL_TIME)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments       TeacherAssignment[]
  sectionsAsTeacher Section[]           @relation("ClassTeacher")
  homework          Homework[]
  timetableEntries  TimetableEntry[]
  lessonPlans       LessonPlan[]

  @@unique([schoolId, employeeNo])
  @@index([schoolId])
}

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String?       @unique
  schoolId      String
  admissionNo   String
  admissionDate DateTime      @db.Date
  dateOfBirth   DateTime      @db.Date
  gender        Gender
  bloodGroup    String?
  address       String?       @db.Text
  rollNo        String?
  photoUrl      String?       @db.MediumText
  status        StudentStatus @default(ACTIVE)
  sectionId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  school                 School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section                Section?                @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  guardians              StudentGuardian[]
  attendances            Attendance[]
  examResults            ExamResult[]
  invoices               Invoice[]
  bookLoans              BookLoan[]
  transportSubscriptions TransportSubscription[]
  homeworkSubmissions    HomeworkSubmission[]
  serviceRequests        ServiceRequest[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([sectionId])
}

model Guardian {
  id         String   @id @default(cuid())
  userId     String?  @unique
  schoolId   String
  firstName  String
  lastName   String
  email      String?
  phone      String
  occupation String?
  address    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students StudentGuardian[]

  @@index([schoolId])
}

model StudentGuardian {
  id         String           @id @default(cuid())
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)

  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian       @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
}

model TeacherAssignment {
  id             String   @id @default(cuid())
  teacherId      String
  sectionId      String
  subjectId      String
  academicYearId String
  createdAt      DateTime @default(now())

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId, subjectId, academicYearId])
}

// ---------------------------------------------------------------------------
// Admissions & enquiries
// ---------------------------------------------------------------------------

model Admission {
  id                 String          @id @default(cuid())
  schoolId           String
  applicantName      String
  dateOfBirth        DateTime?       @db.Date
  gender             Gender?
  guardianName       String
  guardianPhone      String
  guardianEmail      String?
  address            String?         @db.Text
  previousSchool     String?
  classLevelId       String?
  academicYearId     String?
  status             AdmissionStatus @default(ENQUIRY)
  source             AdmissionSource @default(WALK_IN)
  notes              String?         @db.Text
  followUpDate       DateTime?       @db.Date
  appliedAt          DateTime        @default(now())
  decidedAt          DateTime?
  enrolledStudentId  String?
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel?   @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("AdmissionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
  @@index([classLevelId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Lesson planning & learning content
// ---------------------------------------------------------------------------

model LessonPlan {
  id              String           @id @default(cuid())
  schoolId        String
  subjectId       String
  classLevelId    String
  sectionId       String?
  syllabusUnitId  String?
  teacherId       String?
  title           String
  objectives      String?          @db.Text
  activities      String?          @db.Text
  resources       String?          @db.Text
  assessment      String?          @db.Text
  plannedDate     DateTime?        @db.Date
  durationMinutes Int?
  status          LessonPlanStatus @default(PLANNED)
  notes           String?          @db.Text
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  section      Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  syllabusUnit SyllabusUnit?   @relation(fields: [syllabusUnitId], references: [id], onDelete: SetNull)
  teacher      TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("LessonPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([subjectId, classLevelId])
  @@index([plannedDate])
  @@index([status])
}

model LearningContent {
  id           String               @id @default(cuid())
  schoolId     String
  subjectId    String?
  classLevelId String?
  title        String
  description  String?              @db.Text
  type         LearningContentType  @default(LINK)
  url          String?              @db.Text
  tags         String?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classLevel ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("LearningContentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([subjectId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Service requests & certificates
// ---------------------------------------------------------------------------

model ServiceRequest {
  id            String              @id @default(cuid())
  schoolId      String
  type          ServiceRequestType  @default(OTHER)
  title         String
  description   String?             @db.Text
  status        ServiceRequestStatus @default(PENDING)
  studentId     String?
  requestedById String?
  resolvedById  String?
  response      String?             @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  requestedBy User?           @relation("ServiceRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  resolvedBy  User?           @relation("ServiceRequestResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([status])
  @@index([type])
  @@index([studentId])
  @@index([requestedById])
}

// ---------------------------------------------------------------------------
// Attendance
// ---------------------------------------------------------------------------

model Attendance {
  id             String           @id @default(cuid())
  studentId      String
  sectionId      String
  academicYearId String
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  remarks        String?
  recordedById   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section      Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  recordedBy   User?          @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([sectionId, date])
}

// ---------------------------------------------------------------------------
// Exams & results
// ---------------------------------------------------------------------------

model Exam {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  termId         String?
  classLevelId   String
  name           String
  type           ExamType @default(UNIT_TEST)
  maxMarks       Int      @default(100)
  passingMarks   Int      @default(0)
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  term         Term?        @relation(fields: [termId], references: [id], onDelete: SetNull)
  classLevel   ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  results      ExamResult[]

  @@index([schoolId])
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  subjectId     String
  marksObtained Decimal  @db.Decimal(6, 2)
  maxMarks      Decimal  @default(100) @db.Decimal(6, 2)
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subjectId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Fees & finance
// ---------------------------------------------------------------------------

model FeeCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  createdAt   DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]

  @@unique([schoolId, name])
}

model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  classLevelId   String
  feeCategoryId  String
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency @default(ANNUAL)
  dueDay         Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel    @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  feeCategory  FeeCategory   @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  invoiceItems InvoiceItem[]

  @@unique([academicYearId, classLevelId, feeCategoryId])
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  invoiceNo      String
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  status         InvoiceStatus @default(ISSUED)
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(10, 2)
  balance        Decimal       @default(0) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([schoolId, invoiceNo])
  @@index([studentId])
  @@index([status])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  amount         Decimal @db.Decimal(10, 2)
  feeStructureId String?

  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod @default(CASH)
  reference    String?
  paidAt       DateTime      @default(now())
  receivedById String?
  notes        String?
  createdAt    DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receivedBy User?   @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Library
// ---------------------------------------------------------------------------

model Book {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  author          String
  isbn            String?
  category        String?
  publisher       String?
  publishedYear   Int?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  shelf           String?
  coverUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  loans  BookLoan[]

  @@unique([schoolId, isbn])
  @@index([schoolId])
  @@index([title])
}

model BookLoan {
  id         String     @id @default(cuid())
  bookId     String
  studentId  String?
  userId     String?
  borrowedAt DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  status     LoanStatus @default(BORROWED)
  fine       Decimal    @default(0) @db.Decimal(8, 2)
  issuedById String?
  // Non-null only while the loan is active (BORROWED/OVERDUE); used to
  // enforce at most one active loan per (book, borrower) via a unique index.
  // MySQL permits multiple NULLs in a unique index, so closed loans are exempt.
  activeKey  String?    @unique
  createdAt  DateTime   @default(now())

  book     Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student  StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  user     User?           @relation("LoanBorrower", fields: [userId], references: [id], onDelete: SetNull)
  issuedBy User?           @relation("LoanIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Transport
// ---------------------------------------------------------------------------

model Driver {
  id            String   @id @default(cuid())
  schoolId      String
  driverCode    String
  name          String
  phone         String
  licenseNumber String
  licenseExpiry DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([schoolId, driverCode])
  @@unique([schoolId, licenseNumber])
  @@index([schoolId])
}

model Vehicle {
  id              String        @id @default(cuid())
  schoolId        String
  vehicleCode     String?
  plateNumber     String
  model           String?
  type            VehicleType   @default(BUS)
  capacity        Int
  driverName      String?
  driverPhone     String?
  driverId        String?
  routeId         String?
  status          VehicleStatus @default(ACTIVE)
  insuranceExpiry DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  routes TransportRoute[]
  driver Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  route  TransportRoute?  @relation("RouteVehicles", fields: [routeId], references: [id], onDelete: SetNull)

  @@unique([schoolId, plateNumber])
  @@unique([schoolId, vehicleCode])
  @@index([schoolId, routeId])
  @@index([schoolId, driverId])
}

model TransportRoute {
  id          String   @id @default(cuid())
  schoolId    String
  routeCode   String?
  name        String
  code        String
  description String?
  startPoint  String?
  endPoint    String?
  pickupTime  String?
  dropTime    String?
  fare        Decimal  @default(0) @db.Decimal(8, 2)
  vehicleId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicle       Vehicle?                @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicles      Vehicle[]               @relation("RouteVehicles")
  stops         RouteStop[]
  subscriptions TransportSubscription[]

  @@unique([schoolId, code])
  @@unique([schoolId, routeCode])
}

model RouteStop {
  id         String   @id @default(cuid())
  routeId    String
  name       String
  sequence   Int
  pickupTime String?
  dropTime   String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  route         TransportRoute          @relation(fields: [routeId], references: [id], onDelete: Cascade)
  subscriptions TransportSubscription[]

  @@unique([routeId, sequence])
}

model TransportSubscription {
  id             String          @id @default(cuid())
  studentId      String
  routeId        String
  stopId         String?
  academicYearId String
  status         TransportStatus @default(ACTIVE)
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop         RouteStop?     @relation(fields: [stopId], references: [id], onDelete: SetNull)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Communication & audit
// ---------------------------------------------------------------------------

model Notice {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  body        String    @db.Text
  audience    Json?
  isPinned    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("NoticeAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([schoolId])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([userId])
  @@index([entity, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  schoolId  String?
  type      NotificationType @default(GENERAL)
  title     String
  body      String?          @db.Text
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([schoolId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Messaging: conversations, participants, messages
// ---------------------------------------------------------------------------

model Conversation {
  id            String   @id @default(cuid())
  schoolId      String
  createdById   String
  subject       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([schoolId])
  @@index([createdById])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationParticipant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Daily activities: homework, timetable, syllabus
// ---------------------------------------------------------------------------

model Homework {
  id           String   @id @default(cuid())
  schoolId     String
  sectionId    String
  subjectId    String
  teacherId    String?
  title        String
  description  String?  @db.Text
  materials    String?  @db.Text
  assignedDate DateTime @db.Date
  dueDate      DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  attachments HomeworkAttachment[]
  submissions HomeworkSubmission[]

  @@index([schoolId])
  @@index([sectionId, dueDate])
}

model HomeworkAttachment {
  id         String   @id @default(cuid())
  homeworkId String
  name       String
  url        String   @db.Text
  createdAt  DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
}

model HomeworkSubmission {
  id          String           @id @default(cuid())
  homeworkId  String
  studentId   String
  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime?
  remarks     String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  homework Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId])
}

model TimetableEntry {
  id        String   @id @default(cuid())
  schoolId  String
  sectionId String
  subjectId String
  teacherId String?
  dayOfWeek Weekday
  startTime String
  endTime   String
  room      String?
  materials String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, dayOfWeek, startTime])
  @@index([schoolId])
  @@index([sectionId, dayOfWeek])
}

model SyllabusUnit {
  id            String         @id @default(cuid())
  schoolId      String
  subjectId     String
  classLevelId  String
  title         String
  description   String?        @db.Text
  upcomingTopic String?        @db.Text
  orderIndex    Int            @default(0)
  status        SyllabusStatus @default(NOT_STARTED)
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]

  @@unique([subjectId, classLevelId, title])
  @@index([schoolId])
  @@index([subjectId, classLevelId])
}

// ---------------------------------------------------------------------------
// Public website
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  source    String?  @default("website")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
